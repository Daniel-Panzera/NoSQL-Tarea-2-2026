            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un CSV', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{usuarios_url}}/api/usuarios/exportar?formato=csv",
              "host": ["{{usuarios_url}}"],
              "path": ["api", "usuarios", "exportar"],
              "query": [{ "key": "formato", "value": "csv" }]
            }
          }
        }
      ]
